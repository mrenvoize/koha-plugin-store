{
  # Github user access token
  github_user_access_token => "YOUR_TOKEN_HERE",

  # Postgres connection string — 'postgres' is the docker-compose service name,
  # reachable from inside the app container on the compose network. If you're
  # running the app directly on the host instead (not via Docker), use
  # koha_plugin_store.conf.example instead, which points at 127.0.0.1:55432.
  pg_dsn => 'postgresql://koha_plugin_store:koha_plugin_store@postgres:5432/koha_plugin_store',
};
